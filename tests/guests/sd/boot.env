# The project's U-Boot boot configuration (docs/decisions/DR-0007): the
# environment build-image.sh writes into each card's U-Boot environment
# block (uboot-env.py), where the vendor U-Boot reads it from mmc 0 at
# start. It replaces the vendor default boot command, which resets the
# environment and names the root by device (root=/dev/mmcblk0p2 or
# mmcblk1p2, chosen by whether mmc 1 has a card).
#
# Two separate choices:
#   kernel_iface, kernel_part  where U-Boot loads boot/Image and the DTB
#                              (U-Boot's device numbers, from its bind
#                              order: mmc 0 = SDHI0, the module slot;
#                              mmc 1 = SDHI1, the carrier slot)
#   root_partuuid              Linux's root partition, by its PARTUUID,
#                              on any medium: Linux's mmcblk numbering
#                              does not take part
# root_wait: seconds Linux waits for the root partition; then it stops
# with "VFS: Unable to mount root fs", naming the PARTUUID.
# @PARTUUID-2@ is this card's own partition 2.
# The block holds the vendor's built-in default environment
# (../out/fw/u-boot-initial-env, from build-u-boot.sh) with these lines
# added or replacing: what `saveenv` would store after setting them.
#
# bootargs is quoted and ends in spaces on purpose. At booti the vendor
# U-Boot appends " wdt_overflow=0" to the bootargs string in place
# (strcat, arch/arm/lib/bootm.c:208), past the end of its heap
# allocation unless the allocation happens to have room; the overrun
# corrupts U-Boot's heap (an unpadded bootargs, in a first environment
# without the vendor defaults, ended in a synchronous abort before Linux). The spaces make the allocation fit the
# appended text exactly; Linux ignores them. uboot-env.py refuses a
# bootargs that would overrun.
bootcmd=run rzv2l_boot
kernel_iface=mmc
kernel_part=0:2
root_partuuid=@PARTUUID-2@
root_wait=30
rzv2l_boot=ext4load ${kernel_iface} ${kernel_part} 0x48080000 boot/Image && ext4load ${kernel_iface} ${kernel_part} 0x48000000 boot/r9a07g054l2-smarc.dtb && setenv bootargs "rw rootwait=${root_wait} earlycon root=PARTUUID=${root_partuuid}       " && booti 0x48080000 - 0x48000000
