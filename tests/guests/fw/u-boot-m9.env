# The M9 profile's U-Boot environment (docs/decisions/DR-0008).
# build-u-boot-m9.sh builds it in as U-Boot's default environment
# (CONFIG_USE_DEFAULT_ENV_FILE), so that when both stored copies are
# invalid U-Boot still runs this policy, never the vendor's unsigned
# boot; ../sd/build-image.sh --m9 writes it into both copies on the card.
# One variable per line (mkenvimage format); # starts a comment.
#
# Slot state, with RAUC's names (DR-0008 decision 5): BOOT_ORDER, and
# the attempts left per slot. M9_PENDING, M9_GOOD and M9_ROLLBACK are
# written by Linux (M9-ab) and are absent here.
#
# bootcmd (DR-0008 decision 6): take the first slot in BOOT_ORDER with
# an attempt left; spend the attempt and save it before trying; if the
# save fails, stop. Load the slot's FIT and bootm its configuration; if
# bootm returns, say why and reset (the attempt is spent). With no
# attempt left, print the state and stop at the prompt. U-Boot's
# setexpr and itest count in hexadecimal; the counters stay below 10.
#
# bootm checks FIT signatures and hashes only while the variable verify
# is not "n" (boot/bootm.c:262 env_get_yesno); the boot command sets it
# to yes at run time, after saving, so a stored verify=n does not turn
# the checks off on this path.
#
# The root is the slot's partition by its PARTUUID, read from the card
# at boot (part uuid), as DR-0007 names it. bootargs ends in seven
# spaces: the vendor U-Boot appends " wdt_overflow=N" to it in place
# at boot (arch/arm/lib/bootm.c:208), and the spaces make its heap
# allocation hold that text (DR-0007 decision 6); build-u-boot-m9.sh
# checks the length.
baudrate=115200
bootdelay=2
bootm_size=0x10000000
loadaddr=0x58000000
BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=3
m9_fit=boot/fitImage
root_wait=30
bootcmd=run m9_boot
m9_try_A=if itest ${BOOT_A_LEFT} -gt 0; then setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; setenv m9_slot A; setenv m9_part 2; fi
m9_try_B=if itest ${BOOT_B_LEFT} -gt 0; then setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; setenv m9_slot B; setenv m9_part 3; fi
m9_select=setenv m9_slot; setenv m9_part; for s in ${BOOT_ORDER}; do if test -z "${m9_slot}"; then if test "x${s}" = "xA"; then run m9_try_A; elif test "x${s}" = "xB"; then run m9_try_B; fi; fi; done
m9_boot=run m9_select; if test -z "${m9_slot}"; then echo "M9: no slot has an attempt left: BOOT_ORDER=${BOOT_ORDER} BOOT_A_LEFT=${BOOT_A_LEFT} BOOT_B_LEFT=${BOOT_B_LEFT}"; else if saveenv; then echo "M9: slot ${m9_slot}: attempt saved: BOOT_A_LEFT=${BOOT_A_LEFT} BOOT_B_LEFT=${BOOT_B_LEFT}"; run m9_load; else echo "M9: slot ${m9_slot}: the attempt could not be saved; not booting"; fi; fi
m9_load=if part uuid mmc 0:${m9_part} m9_puuid; then if ext4load mmc 0:${m9_part} ${loadaddr} ${m9_fit}; then setenv bootargs "rw rootwait=${root_wait} earlycon root=PARTUUID=${m9_puuid}       "; setenv verify yes; bootm ${loadaddr}#conf; echo "M9: slot ${m9_slot}: bootm returned: the FIT was refused"; else echo "M9: slot ${m9_slot}: cannot read ${m9_fit}"; fi; else echo "M9: slot ${m9_slot}: no partition ${m9_part}"; fi; echo "M9: slot ${m9_slot}: resetting"; reset
